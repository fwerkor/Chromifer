index 0000000000..3152b57972
--- /dev/null
+++ b/services/data_decoder/public/mojom/gzipper_rust_traits.rs
@@ -0,0 +1,66 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+use super::base_rust::big_buffer::{BigBuffer as MojomBigBuffer, BigBufferSharedMemoryRegion};
+use super::system::buffer::SharedBuffer;
+use anyhow::{anyhow, Result};
+
+const MAX_INLINE_BYTES: usize = 64 * 1024;
+
+#[derive(Debug, PartialEq)]
+pub struct RustBigBuffer(Vec<u8>);
+
+impl RustBigBuffer {
+    pub fn into_vec(self) -> Vec<u8> {
+        self.0
+    }
+}
+
+impl From<Vec<u8>> for RustBigBuffer {
+    fn from(bytes: Vec<u8>) -> Self {
+        Self(bytes)
+    }
+}
+
+impl From<RustBigBuffer> for MojomBigBuffer {
+    fn from(buffer: RustBigBuffer) -> Self {
+        let bytes = buffer.0;
+        if bytes.len() <= MAX_INLINE_BYTES || bytes.len() > u32::MAX as usize {
+            return MojomBigBuffer::bytes(bytes);
+        }
+
+        let Ok(shared) = SharedBuffer::create_with_bytes(&bytes) else {
+            return MojomBigBuffer::bytes(bytes);
+        };
+        MojomBigBuffer::shared_memory(BigBufferSharedMemoryRegion {
+            buffer_handle: shared.into(),
+            size: bytes.len() as u32,
+        })
+    }
+}
+
+impl TryFrom<MojomBigBuffer> for RustBigBuffer {
+    type Error = anyhow::Error;
+
+    fn try_from(buffer: MojomBigBuffer) -> Result<Self> {
+        match buffer {
+            MojomBigBuffer::bytes(bytes) => Ok(Self(bytes)),
+            MojomBigBuffer::invalid_buffer(_) => Err(anyhow!("invalid BigBuffer")),
+            MojomBigBuffer::shared_memory(region) => {
+                let size = region.size as usize;
+                if size == 0 {
+                    return Err(anyhow!("zero-sized BigBuffer shared memory"));
+                }
+                let shared = SharedBuffer::from(region.buffer_handle);
+                if shared.size() < size as u64 {
+                    return Err(anyhow!("BigBuffer shared memory is smaller than declared"));
+                }
+                let mapped = shared
+                    .map(0, size)
+                    .map_err(|error| anyhow!("failed to map BigBuffer: {error:?}"))?;
+                Ok(Self(mapped.copy_to_vec()))
+            }
+        }
+    }
+}
diff --git a/services/data_decoder/rust/gzipper.rs b/services/data_decoder/rust/gzipper.rs
new file mode 100644
index 0000000000..92727c0579
--- /dev/null
+++ b/services/data_decoder/rust/gzipper.rs
@@ -0,0 +1,110 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! Rust implementation of the data decoder Gzipper Mojo service.
+
+chromium::import! {
+    "//mojo/public/rust/bindings";
+    "//mojo/public/rust/system";
+    "//services/data_decoder/public/mojom:mojom_gzipper_rust";
+}
+
+use flate2::read::{DeflateDecoder, GzDecoder};
+use flate2::write::{DeflateEncoder, GzEncoder};
+use flate2::Compression;
+use mojom_gzipper_rust::gzipper::Gzipper as GzipperMojom;
+use std::io::{Read, Write};
+
+type BigBuffer = mojom_gzipper_rust::gzipper::RustBigBuffer;
+
+#[cxx::bridge(namespace = "data_decoder")]
+mod ffi {
+    extern "Rust" {
+        fn BindRustGzipper(raw_handle: usize);
+    }
+}
+
+struct Gzipper;
+
+fn encode_deflate(data: Vec<u8>) -> Option<Vec<u8>> {
+    let mut encoder = DeflateEncoder::new(Vec::new(), Compression::default());
+    encoder.write_all(&data).ok()?;
+    encoder.finish().ok()
+}
+
+fn encode_gzip(data: Vec<u8>) -> Option<Vec<u8>> {
+    let mut encoder = GzEncoder::new(Vec::new(), Compression::default());
+    encoder.write_all(&data).ok()?;
+    encoder.finish().ok()
+}
+
+fn decode_with_limit(decoder: impl Read, max_size: u64) -> Option<Vec<u8>> {
+    let mut output = Vec::new();
+    decoder.take(max_size.saturating_add(1)).read_to_end(&mut output).ok()?;
+    if output.len() as u64 > max_size {
+        return None;
+    }
+    Some(output)
+}
+
+fn decode_gzip(mut decoder: impl Read) -> Option<Vec<u8>> {
+    let mut output = Vec::new();
+    decoder.read_to_end(&mut output).ok()?;
+    Some(output)
+}
+
+impl GzipperMojom for Gzipper {
+    fn Deflate(
+        &mut self,
+        data: BigBuffer,
+        response_callback: impl Send + 'static + FnOnce(Option<BigBuffer>),
+    ) {
+        response_callback(encode_deflate(data.into_vec()).map(Into::into));
+    }
+
+    fn Inflate(
+        &mut self,
+        data: BigBuffer,
+        max_uncompressed_size: u64,
+        response_callback: impl Send + 'static + FnOnce(Option<BigBuffer>),
+    ) {
+        let compressed = data.into_vec();
+        response_callback(
+            decode_with_limit(DeflateDecoder::new(compressed.as_slice()), max_uncompressed_size)
+                .map(Into::into),
+        );
+    }
+
+    fn Compress(
+        &mut self,
+        data: BigBuffer,
+        response_callback: impl Send + 'static + FnOnce(Option<BigBuffer>),
+    ) {
+        response_callback(encode_gzip(data.into_vec()).map(Into::into));
+    }
+
+    fn Uncompress(
+        &mut self,
+        compressed_data: BigBuffer,
+        response_callback: impl Send + 'static + FnOnce(Option<BigBuffer>),
+    ) {
+        let compressed = compressed_data.into_vec();
+        response_callback(decode_gzip(GzDecoder::new(compressed.as_slice())).map(Into::into));
+    }
+}
+
+bindings::register_mojom_state_object_impls!(impl GzipperMojom for Gzipper);
+
+#[allow(non_snake_case)]
+fn BindRustGzipper(raw_handle: usize) {
+    use bindings::receiver::PendingReceiver;
+    use system::message_pipe::MessageEndpoint;
+    use system::mojo_types::UntypedHandle;
+
+    // SAFETY: C++ releases a live PendingReceiver handle immediately before
+    // this call, transferring unique ownership of that raw handle to Rust.
+    let untyped = unsafe { UntypedHandle::wrap_raw_value(raw_handle) };
+    let endpoint: MessageEndpoint = untyped.into();
+    let _ = PendingReceiver::<dyn GzipperMojom>::new(endpoint).bind_self_owned(Gzipper);
+}
