+    /// Creates a new shared buffer initialized from owned process memory.
+    ///
+    /// The buffer is not exposed or duplicated until after initialization, so
+    /// callers do not need to reason about cross-process aliasing while the
+    /// bytes are copied into it.
+    pub fn create_with_bytes(bytes: &[u8]) -> MojoResult<SharedBuffer> {
+        let buffer = Self::create(bytes.len() as u64)?;
+        let mut mapped = buffer.map(0, bytes.len())?;
+        // SAFETY: `buffer` was created in this method and has not been
+        // duplicated or exposed, so `mapped` is the only possible access to
+        // its storage for the duration of this copy.
+        unsafe { mapped.as_mut_slice().copy_from_slice(bytes) };
+        drop(mapped);
+        Ok(buffer)
+    }
+
     /// Create a new handle pointing to the same shared buffer as `self`.
     /// The new handle will have full read/write permissions.
     ///
@@ -109,6 +125,20 @@ pub struct MappedBuffer {
 }
 
 impl MappedBuffer {
+    /// Copies the current bytes out of externally shared memory without
+    /// creating a Rust reference to storage that another process may mutate
+    /// concurrently.
+    pub fn copy_to_vec(&self) -> Vec<u8> {
+        let mut bytes = Vec::with_capacity(self.len);
+        for offset in 0..self.len {
+            // SAFETY: `self.ptr` is valid for `self.len` bytes while this mapping
+            // lives. Volatile byte reads tolerate storage changing outside the Rust
+            // memory model and do not create aliased references to that storage.
+            bytes.push(unsafe { self.ptr.as_ptr().add(offset).read_volatile() });
+        }
+        bytes
+    }
+
