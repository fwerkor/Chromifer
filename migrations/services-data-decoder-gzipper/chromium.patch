diff --git a/services/data_decoder/rust/gzipper.rs b/services/data_decoder/rust/gzipper.rs
new file mode 100644
index 0000000000..3dc215fc8d
--- /dev/null
+++ b/services/data_decoder/rust/gzipper.rs
@@ -0,0 +1,152 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! Rust implementation of the data decoder Gzipper Mojo service.
+
+chromium::import! {
+    "//mojo/public/mojom/base:base_rust";
+    "//mojo/public/rust/bindings";
+    "//mojo/public/rust/c_mojo_api" as mojo_ffi;
+    "//mojo/public/rust/system";
+    "//services/data_decoder/public/mojom:mojom_gzipper_rust";
+}
+
+use base_rust::big_buffer::{BigBuffer, BigBufferSharedMemoryRegion};
+use flate2::read::{DeflateDecoder, GzDecoder};
+use flate2::write::{DeflateEncoder, GzEncoder};
+use flate2::Compression;
+use mojom_gzipper_rust::gzipper::Gzipper as GzipperMojom;
+use std::io::{Read, Write};
+
+const MAX_INLINE_BYTES: usize = 64 * 1024;
+
+#[cxx::bridge(namespace = "data_decoder")]
+mod ffi {
+    extern "Rust" {
+        fn BindRustGzipper(raw_handle: usize);
+    }
+}
+
+struct Gzipper;
+
+fn into_bytes(buffer: BigBuffer) -> Option<Vec<u8>> {
+    match buffer {
+        BigBuffer::bytes(bytes) => Some(bytes),
+        BigBuffer::shared_memory(region) => {
+            let size = region.size as usize;
+            if mojo_ffi::buffer::MojoGetBufferInfo(&region.buffer_handle).ok()? < size as u64 {
+                return None;
+            }
+            let ptr = mojo_ffi::buffer::MojoMapBuffer(&region.buffer_handle, 0, size).ok()?;
+            let mut bytes = Vec::with_capacity(size);
+            for offset in 0..size {
+                // SAFETY: MojoMapBuffer guarantees `ptr` is valid for `size`
+                // bytes. Volatile reads copy externally shared storage without
+                // creating a Rust reference that assumes it cannot change.
+                bytes.push(unsafe { ptr.add(offset).read_volatile() });
+            }
+            // SAFETY: `ptr` came from MojoMapBuffer above and is unmapped once.
+            unsafe { mojo_ffi::buffer::MojoUnmapBuffer(ptr).ok()? };
+            Some(bytes)
+        }
+        BigBuffer::invalid_buffer(_) => None,
+    }
+}
+
+fn from_bytes(bytes: Vec<u8>) -> Option<BigBuffer> {
+    if bytes.len() <= MAX_INLINE_BYTES {
+        return Some(BigBuffer::bytes(bytes));
+    }
+    let size: u32 = bytes.len().try_into().ok()?;
+    let handle = mojo_ffi::buffer::MojoCreateSharedBuffer(size.into()).ok()?;
+    let ptr = mojo_ffi::buffer::MojoMapBuffer(&handle, 0, bytes.len()).ok()?;
+    // SAFETY: the shared buffer was created above and has not been exposed or
+    // duplicated, so `ptr` is uniquely writable for `bytes.len()` bytes.
+    unsafe { std::ptr::copy_nonoverlapping(bytes.as_ptr(), ptr, bytes.len()) };
+    // SAFETY: `ptr` came from MojoMapBuffer above and is unmapped once.
+    unsafe { mojo_ffi::buffer::MojoUnmapBuffer(ptr).ok()? };
+    Some(BigBuffer::shared_memory(BigBufferSharedMemoryRegion { buffer_handle: handle, size }))
+}
+
+fn encode(data: BigBuffer, gzip: bool) -> Option<BigBuffer> {
+    let data = into_bytes(data)?;
+    let output = if gzip {
+        let mut encoder = GzEncoder::new(Vec::new(), Compression::default());
+        encoder.write_all(&data).ok()?;
+        encoder.finish().ok()?
+    } else {
+        let mut encoder = DeflateEncoder::new(Vec::new(), Compression::default());
+        encoder.write_all(&data).ok()?;
+        encoder.finish().ok()?
+    };
+    from_bytes(output)
+}
+
+fn decode(data: BigBuffer, gzip: bool, max_size: Option<u64>) -> Option<BigBuffer> {
+    let data = into_bytes(data)?;
+    let mut output = Vec::new();
+    if gzip {
+        GzDecoder::new(data.as_slice()).read_to_end(&mut output).ok()?;
+    } else {
+        let max_size = max_size?;
+        DeflateDecoder::new(data.as_slice())
+            .take(max_size.saturating_add(1))
+            .read_to_end(&mut output)
+            .ok()?;
+        if output.len() as u64 > max_size {
+            return None;
+        }
+    }
+    from_bytes(output)
+}
+
+impl GzipperMojom for Gzipper {
+    fn Deflate(
+        &mut self,
+        data: BigBuffer,
+        response_callback: impl Send + 'static + FnOnce(Option<BigBuffer>),
+    ) {
+        response_callback(encode(data, false));
+    }
+
+    fn Inflate(
+        &mut self,
+        data: BigBuffer,
+        max_uncompressed_size: u64,
+        response_callback: impl Send + 'static + FnOnce(Option<BigBuffer>),
+    ) {
+        response_callback(decode(data, false, Some(max_uncompressed_size)));
+    }
+
+    fn Compress(
+        &mut self,
+        data: BigBuffer,
+        response_callback: impl Send + 'static + FnOnce(Option<BigBuffer>),
+    ) {
+        response_callback(encode(data, true));
+    }
+
+    fn Uncompress(
+        &mut self,
+        compressed_data: BigBuffer,
+        response_callback: impl Send + 'static + FnOnce(Option<BigBuffer>),
+    ) {
+        response_callback(decode(compressed_data, true, None));
+    }
+}
+
+bindings::register_mojom_state_object_impls!(impl GzipperMojom for Gzipper);
+
+#[allow(non_snake_case)]
+fn BindRustGzipper(raw_handle: usize) {
+    use bindings::receiver::PendingReceiver;
+    use system::message_pipe::MessageEndpoint;
+    use system::mojo_types::UntypedHandle;
+
+    // SAFETY: C++ releases a live PendingReceiver handle immediately before
+    // this call, transferring unique ownership of that raw handle to Rust.
+    let untyped = unsafe { UntypedHandle::wrap_raw_value(raw_handle) };
+    let endpoint: MessageEndpoint = untyped.into();
+    let _ = PendingReceiver::<dyn GzipperMojom>::new(endpoint).bind_self_owned(Gzipper);
+}
