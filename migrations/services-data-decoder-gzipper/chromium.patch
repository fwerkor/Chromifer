+def _CollectTypemapNamesForKind(ty: mojom.Kind, typemap: dict,
+                                names: set) -> None:
+  '''Collect typemapped Mojom types referenced by a field/parameter kind.'''
+  if mojom.IsNullableKind(ty):
+    ty = ty.MakeUnnullableKind()
+
+  if hasattr(ty, 'qualified_name') and ty.qualified_name in typemap:
+    names.add(ty.qualified_name)
+    return
+
+  if mojom.IsArrayKind(ty):
+    _CollectTypemapNamesForKind(ty.kind, typemap, names)
+  elif mojom.IsMapKind(ty):
+    _CollectTypemapNamesForKind(ty.key_kind, typemap, names)
+    _CollectTypemapNamesForKind(ty.value_kind, typemap, names)
+
+
+def _GetUsedTypemapNames(module: mojom.Module, typemap: dict) -> set:
+  '''Return typemapped types declared by or referenced from this module.'''
+  names = set()
+
+  for kind in module.structs + module.enums + module.unions:
+    if hasattr(kind, 'qualified_name') and kind.qualified_name in typemap:
+      names.add(kind.qualified_name)
+
+  for struct in module.structs:
+    for field in struct.fields:
+      _CollectTypemapNamesForKind(field.kind, typemap, names)
+
+  for union in module.unions:
+    for field in union.fields:
+      _CollectTypemapNamesForKind(field.kind, typemap, names)
+
+  for interface in module.interfaces:
+    for method in interface.methods:
+      for parameter in method.parameters:
+        _CollectTypemapNamesForKind(parameter.kind, typemap, names)
+      for parameter in method.response_parameters or []:
+        _CollectTypemapNamesForKind(parameter.kind, typemap, names)
+
+  return names
+
