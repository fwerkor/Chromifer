+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Cao Yuhang <caoyuhang@fwerkor.com>
+Date: Thu, 20 Aug 2026 11:00:00 +0800
+Subject: [PATCH] Expose element-local namespace declarations
+
+Chromium's data_decoder compatibility layer needs to distinguish namespace
+mappings explicitly declared on an element from mappings inherited from its
+ancestors. Keep XmlEvent::StartElement's cumulative namespace unchanged and
+expose the current NamespaceStack layer through EventReader instead.
+---
+diff --git a/third_party/rust/chromium_crates_io/vendor/xml-v1/src/reader.rs b/third_party/rust/chromium_crates_io/vendor/xml-v1/src/reader.rs
+index 2c640657d4..c93cf9949a 100644
+--- a/third_party/rust/chromium_crates_io/vendor/xml-v1/src/reader.rs
++++ b/third_party/rust/chromium_crates_io/vendor/xml-v1/src/reader.rs
+@@ -8,6 +8,7 @@ use std::iter::FusedIterator;
+ use std::result;
+ 
+ use crate::common::{Position, TextPosition};
++use crate::namespace::Namespace;
+ 
+ pub use config::ParserConfig;
+ pub use error::{Error, ErrorKind, ImmutableEntitiesError};
+@@ -63,6 +64,16 @@ impl<R: Read> EventReader<R> {
+         self.parser.next(&mut self.source)
+     }
+ 
++    /// Returns namespace declarations made on the current element.
++    ///
++    /// This is meaningful immediately after a `StartElement` event. Unlike
++    /// the namespace attached to that event, which is cumulative, this only
++    /// contains declarations written on that element.
++    #[inline]
++    pub fn namespace_declarations(&self) -> &Namespace {
++        self.parser.namespace_declarations()
++    }
++
