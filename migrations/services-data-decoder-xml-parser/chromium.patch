+
+        assert_eq!(super::name_len(b"abc"), 3);
+        assert_eq!(super::name_len(b"abc "), 3);
+
+        assert_eq!(super::name_len(b"a bc"), 1);
+        assert_eq!(super::name_len(b"ab\tc"), 2);
+        assert_eq!(super::name_len(b"ab\rc"), 2);
+        assert_eq!(super::name_len(b"ab\nc"), 2);
