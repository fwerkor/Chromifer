+                    )),
+                );
+                assert_eq!(&resolver.buffer[s..], "");
+            }
+
+            /// `xmlns` prefix cannot be re-declared
+            #[test]
+            fn rebound_to_incorrect_ns() {
+                let mut resolver = NamespaceResolver::default();
+                let s = resolver.buffer.len();
+                assert_eq!(
+                    resolver.push(&BytesStart::from_content(
