+        }
+    }
+
+    #[test]
+    fn undeclared_prefix() {
+        let name = QName("unknown:prefix");
+
+        let resolver = NamespaceResolver::default();
+
+        assert_eq!(
+            resolver.buffer,
+            "xmlhttp://www.w3.org/XML/1998/namespacexmlnshttp://www.w3.org/2000/xmlns/"
