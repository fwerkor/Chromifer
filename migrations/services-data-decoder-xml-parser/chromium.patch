diff --git a/services/data_decoder/xml/xml_parser_mojo.rs b/services/data_decoder/xml/xml_parser_mojo.rs
new file mode 100644
index 0000000000..50ba5ee92b
--- /dev/null
+++ b/services/data_decoder/xml/xml_parser_mojo.rs
@@ -0,0 +1,196 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! Rust-native implementation of the production data_decoder XmlParser Mojo
+//! service.
+
+chromium::import! {
+    "//mojo/public/mojom/base:base_rust";
+    "//mojo/public/rust/bindings";
+    "//mojo/public/rust/system";
+    "//services/data_decoder/public/mojom:mojom_xml_parser_rust";
+}
+
+use base_rust::values::{DictionaryValue, ListValue, Value};
+use bindings::receiver::PendingReceiver;
+use mojom_xml_parser_rust::xml_parser::{
+    XmlParser as XmlParserMojom, XmlParser_WhitespaceBehavior as WhitespaceBehavior,
+};
+use std::collections::HashMap;
+use system::message_pipe::MessageEndpoint;
+use system::mojo_types::UntypedHandle;
+use xml::reader::{EventReader, XmlEvent};
+
+const MAX_DEPTH: usize = 200;
+const TYPE: &str = "type";
+const TAG: &str = "tag";
+const TEXT: &str = "text";
+const ATTRIBUTES: &str = "attributes";
+const CHILDREN: &str = "children";
+const NAMESPACES: &str = "namespaces";
+const ELEMENT: &str = "element";
+const TEXT_NODE: &str = "text";
+const CDATA_NODE: &str = "cdata";
+
+type Dict = HashMap<String, Value>;
+
+#[cxx::bridge(namespace = "data_decoder")]
+mod ffi {
+    extern "Rust" {
+        fn BindXmlParser(raw_handle: usize);
+    }
+}
+
+struct XmlParser;
+
+fn string(value: impl Into<String>) -> Value {
+    Value::string_value(value.into())
+}
+
+fn dictionary(storage: Dict) -> Value {
+    Value::dictionary_value(DictionaryValue { storage })
+}
+
+fn qualified_name(local: &str, prefix: Option<&str>) -> String {
+    prefix.map_or_else(|| local.to_owned(), |prefix| format!("{prefix}:{local}"))
+}
+
+fn add_child(parent: &mut Dict, child: Value) {
+    let value = parent
+        .entry(CHILDREN.to_owned())
+        .or_insert_with(|| Value::list_value(ListValue { storage: Vec::new() }));
+    let Value::list_value(children) = value else {
+        unreachable!("XmlParser children must remain a list")
+    };
+    children.storage.push(child);
+}
+
+fn text_node(kind: &str, text: String) -> Value {
+    dictionary(Dict::from([(TYPE.to_owned(), string(kind)), (TEXT.to_owned(), string(text))]))
+}
+
+fn legacy_error(input: &str, error: &str) -> String {
+    let mut message = error.to_owned();
+    if error.contains("Unexpected end of stream: no root element found") {
+        message =
+            if input.is_empty() { "Document is empty" } else { "Start tag expected" }.to_owned();
+    } else if error.contains("Unexpected characters outside the root element") {
+        message = "Start tag expected".to_owned();
+    } else if error.contains("Unexpected end of stream: still inside the root element") {
+        message = "Premature end of data in tag".to_owned();
+    } else if let Some(rest) = error.split("Unexpected closing tag: ").nth(1) {
+        if let Some((closing, opening)) = rest.split_once(" != ") {
+            let line = error.split(':').next().unwrap_or("1");
+            message =
+                format!("Opening and ending tag mismatch: {opening} line {line} and {closing}");
+        }
+    }
+    format!("Invalid XML: failed to load: {message}")
+}
+
+fn parse(xml: &str, preserve_whitespace: bool) -> Result<Value, String> {
+    let mut parser = EventReader::from_str(xml);
+    let mut stack: Vec<Dict> = Vec::new();
+    let mut root = None;
+
+    loop {
+        match parser.next() {
+            Ok(XmlEvent::StartElement { name, attributes, .. }) => {
+                if root.is_some() || stack.len() >= MAX_DEPTH {
+                    return Err("Invalid XML".to_owned());
+                }
+                let mut node = Dict::from([
+                    (TYPE.to_owned(), string(ELEMENT)),
+                    (
+                        TAG.to_owned(),
+                        string(qualified_name(&name.local_name, name.prefix.as_deref())),
+                    ),
+                ]);
+                if !attributes.is_empty() {
+                    let values = attributes
+                        .into_iter()
+                        .map(|attr| {
+                            (
+                                qualified_name(&attr.name.local_name, attr.name.prefix.as_deref()),
+                                string(attr.value),
+                            )
+                        })
+                        .collect();
+                    node.insert(ATTRIBUTES.to_owned(), dictionary(values));
+                }
+                let namespaces: Dict = parser
+                    .namespace_declarations()
+                    .iter()
+                    .filter(|(prefix, _)| *prefix != "xml" && *prefix != "xmlns")
+                    .filter(|(prefix, uri)| {
+                        !(stack.is_empty() && prefix.is_empty() && uri.is_empty())
+                    })
+                    .map(|(prefix, uri)| (prefix.to_owned(), string(uri.to_owned())))
+                    .collect();
+                if !namespaces.is_empty() {
+                    node.insert(NAMESPACES.to_owned(), dictionary(namespaces));
+                }
+                stack.push(node);
+            }
+            Ok(XmlEvent::EndElement { .. }) => {
+                let Some(child) = stack.pop() else {
+                    return Err("Invalid XML".to_owned());
+                };
+                let child = dictionary(child);
+                if let Some(parent) = stack.last_mut() {
+                    add_child(parent, child);
+                } else {
+                    root = Some(child);
+                }
+            }
+            Ok(XmlEvent::Characters(data)) | Ok(XmlEvent::Whitespace(data)) => {
+                if preserve_whitespace || !data.trim().is_empty() {
+                    let Some(parent) = stack.last_mut() else {
+                        return Err("Invalid XML".to_owned());
+                    };
+                    add_child(parent, text_node(TEXT_NODE, data));
+                }
+            }
+            Ok(XmlEvent::CData(data)) => {
+                let Some(parent) = stack.last_mut() else {
+                    return Err("Invalid XML".to_owned());
+                };
+                add_child(parent, text_node(CDATA_NODE, data));
+            }
+            Ok(XmlEvent::EndDocument) => break,
+            Ok(XmlEvent::Comment(_))
+            | Ok(XmlEvent::ProcessingInstruction { .. })
+            | Ok(XmlEvent::StartDocument { .. })
+            | Ok(XmlEvent::Doctype { .. }) => {}
+            Err(error) => return Err(legacy_error(xml, &error.to_string())),
+        }
+    }
+
+    root.ok_or_else(|| legacy_error(xml, "Unexpected end of stream: no root element found"))
+}
+
+impl XmlParserMojom for XmlParser {
+    fn Parse(
+        &mut self,
+        xml: String,
+        whitespace_behavior: WhitespaceBehavior,
+        response_callback: impl Send + 'static + FnOnce(Option<Value>, Option<String>),
+    ) {
+        let result = parse(&xml, whitespace_behavior == WhitespaceBehavior::kPreserveSignificant);
+        let (value, error) =
+            result.map_or_else(|error| (None, Some(error)), |value| (Some(value), None));
+        response_callback(value, error);
+    }
+}
+
+bindings::register_mojom_state_object_impls!(impl XmlParserMojom for XmlParser);
+
+#[allow(non_snake_case)]
+fn BindXmlParser(raw_handle: usize) {
+    // SAFETY: C++ releases a live PendingReceiver handle immediately before
+    // this call, transferring unique ownership of that raw handle to Rust.
+    let untyped = unsafe { UntypedHandle::wrap_raw_value(raw_handle) };
+    let endpoint: MessageEndpoint = untyped.into();
+    let _ = PendingReceiver::<dyn XmlParserMojom>::new(endpoint).bind_self_owned(XmlParser);
+}
