+            let attr = Attribute {
+                key: QName("foo"),
+                value: Cow::Borrowed(raw_value),
+            };
+            fn custom_resolver(ent: &str) -> Option<&'static str> {
+                match ent {
+                    "d" => Some("&#xD;"),
