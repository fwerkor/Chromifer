+const fn is_xml10_normalization_char(b: &u8) -> bool {
+    // The following sequences should be translated into a single `\n` (U+000a) character
+    // to normalize EOLs:
+    //
+    // |UTF-8   |String|
+    // |--------|------|
+    // |0d 0a   |\r\n  |
+    // |0d      |\r    |
+    matches!(*b, b'\t' | b'\r' | b'\n' | b'&')
