diff --git a/mojo/public/rust/mojom_value_parser/direct_serialize.rs b/mojo/public/rust/mojom_value_parser/direct_serialize.rs
new file mode 100644
index 0000000000000000000000000000000000000000..13a38eb499ff31b2d827430dc7b81d674a5a0a43
--- /dev/null
+++ b/mojo/public/rust/mojom_value_parser/direct_serialize.rs
@@ -0,0 +1,567 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! Allocation-light serialization support for generated Rust Mojom values.
+//!
+//! The legacy serializer first materializes a recursive `MojomValue` tree. This
+//! module provides the low-level writer used by `MojomParse` implementations
+//! that can serialize their typed representation directly.
+
+use crate::ast::*;
+use crate::pack::pack_array_body;
+use smallvec::SmallVec;
+
+#[derive(Clone, Copy)]
+struct BitSlot {
+    location: usize,
+    mask: u8,
+}
+
+#[derive(Clone, Copy)]
+enum ValueSlot<'a> {
+    Bit(BitSlot),
+    Inline { location: usize, wire_type: &'a MojomWireType },
+}
+
+/// Describes the reserved wire location for one logical struct field or array
+/// element. The value and nullable tag can be packed independently.
+#[doc(hidden)]
+#[derive(Clone, Copy, Default)]
+pub struct DirectSlot<'a> {
+    value: Option<ValueSlot<'a>>,
+    tag: Option<BitSlot>,
+}
+
+/// Destination for a directly serialized Mojom value.
+#[doc(hidden)]
+#[derive(Clone, Copy)]
+pub enum DirectTarget<'a> {
+    /// The top-level Mojom payload. Only structs are valid here.
+    Root(&'a MojomWireType),
+    /// A field or array element whose inline storage has already been reserved.
+    Field(DirectSlot<'a>),
+}
+
+/// Stateful wire writer for direct serialization.
+#[doc(hidden)]
+pub struct DirectEncoder {
+    bytes: Vec<u8>,
+    handles: Vec<UntypedHandle>,
+}
+
+/// Deferred second half of a directly serialized Mojom map. Mojo validation
+/// expects depth-first object ordering, so the value array cannot be reserved
+/// until the key array and all nested key data have been emitted.
+#[doc(hidden)]
+pub struct DirectMapValues<'a> {
+    pointer_location: usize,
+    value_type: &'a MojomWireType,
+    num_elements: usize,
+}
+
+struct LinearSlots<'a> {
+    location: usize,
+    stride: usize,
+    wire_type: &'a MojomWireType,
+    remaining: usize,
+}
+
+/// Iterator over reserved array/map slots. Common homogeneous arrays are
+/// represented arithmetically, avoiding a heap allocation proportional to the
+/// number of elements.
+#[doc(hidden)]
+pub struct DirectSlots<'a> {
+    linear: Option<LinearSlots<'a>>,
+    materialized: SmallVec<[DirectSlot<'a>; 4]>,
+    index: usize,
+}
+
+impl<'a> DirectSlots<'a> {
+    fn linear(
+        location: usize,
+        stride: usize,
+        wire_type: &'a MojomWireType,
+        remaining: usize,
+    ) -> Self {
+        Self {
+            linear: Some(LinearSlots { location, stride, wire_type, remaining }),
+            materialized: SmallVec::new(),
+            index: 0,
+        }
+    }
+
+    fn materialized(slots: SmallVec<[DirectSlot<'a>; 4]>) -> Self {
+        Self { linear: None, materialized: slots, index: 0 }
+    }
+}
+
+impl<'a> Iterator for DirectSlots<'a> {
+    type Item = DirectSlot<'a>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        if let Some(linear) = &mut self.linear {
+            if linear.remaining == 0 {
+                return None;
+            }
+            let slot = DirectSlot {
+                value: Some(ValueSlot::Inline {
+                    location: linear.location,
+                    wire_type: linear.wire_type,
+                }),
+                tag: None,
+            };
+            linear.location += linear.stride;
+            linear.remaining -= 1;
+            return Some(slot);
+        }
+        let slot = self.materialized.get(self.index).copied();
+        self.index += usize::from(slot.is_some());
+        slot
+    }
+
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        let remaining = if let Some(linear) = &self.linear {
+            linear.remaining
+        } else {
+            self.materialized.len().saturating_sub(self.index)
+        };
+        (remaining, Some(remaining))
+    }
+}
+
+impl ExactSizeIterator for DirectSlots<'_> {}
+
+impl DirectEncoder {
+    pub fn new() -> Self {
+        Self { bytes: Vec::new(), handles: Vec::new() }
+    }
+
+    pub fn into_parts(self) -> (Vec<u8>, Vec<UntypedHandle>, u64) {
+        // Direct serialization is only selected when every nested field supports
+        // it. Associated endpoints currently opt out, so there are no interface
+        // IDs to append on this path.
+        (self.bytes, self.handles, 0)
+    }
+
+    fn align(value: usize, alignment: usize) -> usize {
+        value + (alignment - value % alignment) % alignment
+    }
+
+    fn write_u32(&mut self, location: usize, value: u32) {
+        self.bytes[location..location + 4].copy_from_slice(&value.to_le_bytes());
+    }
+
+    fn write_u64(&mut self, location: usize, value: u64) {
+        self.bytes[location..location + 8].copy_from_slice(&value.to_le_bytes());
+    }
+
+    fn set_bit(&mut self, bit: BitSlot, value: bool) {
+        if value {
+            self.bytes[bit.location] |= bit.mask;
+        } else {
+            self.bytes[bit.location] &= !bit.mask;
+        }
+    }
+
+    fn nested_start(&mut self, pointer_location: usize) -> usize {
+        debug_assert_eq!(self.bytes.len() % 8, 0);
+        let start = self.bytes.len();
+        self.write_u64(pointer_location, (start - pointer_location) as u64);
+        start
+    }
+
+    fn inline_value<'a>(target: DirectTarget<'a>) -> (usize, &'a MojomWireType) {
+        let DirectTarget::Field(DirectSlot {
+            value: Some(ValueSlot::Inline { location, wire_type }),
+            ..
+        }) = target
+        else {
+            panic!("direct serializer expected an inline value slot")
+        };
+        (location, wire_type.resolve_recursive())
+    }
+
+    fn begin_struct_type<'a>(&mut self, target: DirectTarget<'a>) -> &'a PackedStructuredType {
+        match target {
+            DirectTarget::Root(wire_type) => match wire_type.resolve_recursive() {
+                MojomWireType::Pointer {
+                    nested_data_type: nested_data_type @ PackedStructuredType::Struct { .. },
+                    is_nullable: false,
+                } => {
+                    debug_assert!(self.bytes.is_empty());
+                    nested_data_type
+                }
+                _ => panic!("top-level direct Mojom serialization requires a non-null struct"),
+            },
+            DirectTarget::Field(_) => {
+                let (pointer_location, wire_type) = Self::inline_value(target);
+                let MojomWireType::Pointer { nested_data_type, .. } = wire_type else {
+                    panic!("direct struct field requires a pointer wire type")
+                };
+                if !matches!(nested_data_type, PackedStructuredType::Struct { .. }) {
+                    panic!("direct struct field requires a struct wire type")
+                }
+                self.nested_start(pointer_location);
+                nested_data_type
+            }
+        }
+    }
+
+    fn layout_slots<'a, BitfieldT, IterT>(
+        &mut self,
+        body_start: usize,
+        num_values: usize,
+        packed_fields: IterT,
+        pad_body: bool,
+    ) -> (SmallVec<[DirectSlot<'a>; 4]>, usize)
+    where
+        BitfieldT: std::borrow::Borrow<BitfieldOrdinals>,
+        IterT: Iterator<Item = StructuredBodyElementRef<'a, BitfieldT>>,
+    {
+        let mut slots: SmallVec<[DirectSlot<'a>; 4]> = SmallVec::with_capacity(num_values);
+        slots.resize(num_values, DirectSlot::default());
+        let mut cursor = body_start;
+
+        for packed_field in packed_fields {
+            cursor = Self::align(cursor, packed_field.alignment());
+            let field_size = packed_field.size();
+            match packed_field {
+                StructuredBodyElement::Bitfield(ordinals) => {
+                    for (bit_index, entry) in ordinals.borrow().iter().enumerate() {
+                        let Some((ordinal, is_tag)) = entry else { continue };
+                        let bit = BitSlot { location: cursor, mask: 1 << bit_index };
+                        let slot = slots
+                            .get_mut(*ordinal)
+                            .expect("packed Mojom field ordinal must be in range");
+                        if *is_tag {
+                            slot.tag = Some(bit);
+                        } else {
+                            slot.value = Some(ValueSlot::Bit(bit));
+                        }
+                    }
+                }
+                StructuredBodyElement::SingleValue(ordinal, wire_type) => {
+                    slots[ordinal].value = Some(ValueSlot::Inline {
+                        location: cursor,
+                        wire_type: wire_type.resolve_recursive(),
+                    });
+                }
+            }
+            cursor += field_size;
+        }
+
+        if pad_body {
+            cursor = Self::align(cursor, 8);
+        }
+        (slots, cursor)
+    }
+
+    /// Reserve and initialize a struct body, returning its logical field slots.
+    pub fn begin_struct<'a>(
+        &mut self,
+        target: DirectTarget<'a>,
+        num_fields: usize,
+    ) -> SmallVec<[DirectSlot<'a>; 4]> {
+        let nested_data_type = self.begin_struct_type(target);
+
+        let PackedStructuredType::Struct { packed_field_types, num_elements_in_value, .. } =
+            nested_data_type
+        else {
+            unreachable!()
+        };
+        debug_assert_eq!(*num_elements_in_value, num_fields);
+
+        let start = self.bytes.len();
+        self.bytes.resize(start + 8, 0);
+        let (slots, end) = self.layout_slots(
+            start + 8,
+            num_fields,
+            packed_field_types.iter().map(StructuredBodyElementOwned::as_ref),
+            true,
+        );
+        self.bytes.resize(end, 0);
+        self.write_u32(start, (end - start) as u32);
+        slots
+    }
+
+    /// Reserve a struct with exactly one logical field without allocating or
+    /// initializing an intermediate slot vector. This is common for generated
+    /// wrapper structs such as list and dictionary values.
+    pub fn begin_single_field_struct<'a>(&mut self, target: DirectTarget<'a>) -> DirectSlot<'a> {
+        let nested_data_type = self.begin_struct_type(target);
+        let PackedStructuredType::Struct { packed_field_types, num_elements_in_value, .. } =
+            nested_data_type
+        else {
+            unreachable!()
+        };
+        debug_assert_eq!(*num_elements_in_value, 1);
+
+        let start = self.bytes.len();
+        self.bytes.resize(start + 8, 0);
+        let mut cursor = start + 8;
+        let mut slot = DirectSlot::default();
+        for packed_field in packed_field_types.iter().map(StructuredBodyElementOwned::as_ref) {
+            cursor = Self::align(cursor, packed_field.alignment());
+            let field_size = packed_field.size();
+            match packed_field {
+                StructuredBodyElement::Bitfield(ordinals) => {
+                    for (bit_index, entry) in ordinals.iter().enumerate() {
+                        let Some((ordinal, is_tag)) = entry else { continue };
+                        debug_assert_eq!(*ordinal, 0);
+                        let bit = BitSlot { location: cursor, mask: 1 << bit_index };
+                        if *is_tag {
+                            slot.tag = Some(bit);
+                        } else {
+                            slot.value = Some(ValueSlot::Bit(bit));
+                        }
+                    }
+                }
+                StructuredBodyElement::SingleValue(ordinal, wire_type) => {
+                    debug_assert_eq!(ordinal, 0);
+                    slot.value = Some(ValueSlot::Inline {
+                        location: cursor,
+                        wire_type: wire_type.resolve_recursive(),
+                    });
+                }
+            }
+            cursor += field_size;
+        }
+        let end = Self::align(cursor, 8);
+        self.bytes.resize(end, 0);
+        self.write_u32(start, (end - start) as u32);
+        slot
+    }
+
+    fn begin_array_with_type<'a>(
+        &mut self,
+        pointer_location: usize,
+        element_type: &'a MojomWireType,
+        num_elements: usize,
+    ) -> DirectSlots<'a> {
+        self.nested_start(pointer_location);
+        let start = self.bytes.len();
+        self.bytes.resize(start + 8, 0);
+        self.write_u32(start + 4, num_elements as u32);
+
+        let element_type = element_type.resolve_recursive();
+        if !element_type.is_nullable_primitive()
+            && !matches!(element_type, MojomWireType::Leaf { leaf_type: PackedLeafType::Bool, .. })
+        {
+            let body_start = start + 8;
+            let location = Self::align(body_start, element_type.alignment());
+            let stride = Self::align(element_type.size(), element_type.alignment());
+            let unpadded_end = if num_elements == 0 {
+                body_start
+            } else {
+                location + stride * (num_elements - 1) + element_type.size()
+            };
+            self.write_u32(start, (unpadded_end - start) as u32);
+            self.bytes.resize(Self::align(unpadded_end, 8), 0);
+            return DirectSlots::linear(location, stride, element_type, num_elements);
+        }
+
+        let (slots, unpadded_end) = self.layout_slots(
+            start + 8,
+            num_elements,
+            pack_array_body(element_type, num_elements),
+            false,
+        );
+        self.write_u32(start, (unpadded_end - start) as u32);
+        self.bytes.resize(Self::align(unpadded_end, 8), 0);
+        DirectSlots::materialized(slots)
+    }
+
+    /// Reserve an array body for a generated Rust array/vector.
+    pub fn begin_array<'a>(
+        &mut self,
+        target: DirectTarget<'a>,
+        num_elements: usize,
+    ) -> DirectSlots<'a> {
+        let (pointer_location, wire_type) = Self::inline_value(target);
+        let MojomWireType::Pointer {
+            nested_data_type: PackedStructuredType::Array { element_type, array_type },
+            ..
+        } = wire_type
+        else {
+            panic!("direct array serialization requires an array pointer")
+        };
+        match array_type {
+            PackedArrayType::UnsizedArray => {}
+            PackedArrayType::SizedArray(expected) => assert_eq!(*expected, num_elements),
+            PackedArrayType::String => panic!("strings use write_string()"),
+        }
+        self.begin_array_with_type(pointer_location, element_type, num_elements)
+    }
+
+    /// Serialize a Mojom string without constructing a byte-array MojomValue.
+    pub fn write_string<'a>(&mut self, target: DirectTarget<'a>, value: String) {
+        let (pointer_location, wire_type) = Self::inline_value(target);
+        assert!(matches!(
+            wire_type,
+            MojomWireType::Pointer {
+                nested_data_type: PackedStructuredType::Array {
+                    array_type: PackedArrayType::String,
+                    ..
+                },
+                ..
+            }
+        ));
+        self.nested_start(pointer_location);
+        let start = self.bytes.len();
+        let len: u32 = value.len().try_into().expect("Mojom strings are limited to 2^32 bytes");
+        self.bytes.resize(start + 8, 0);
+        self.write_u32(start, 8 + len);
+        self.write_u32(start + 4, len);
+        self.bytes.extend_from_slice(value.as_bytes());
+        self.bytes.resize(Self::align(self.bytes.len(), 8), 0);
+    }
+
+    /// Mark a nullable field as present. Pointer/union nullability is encoded
+    /// by the value itself; nullable primitives use a separate tag bit.
+    pub fn mark_present(&mut self, target: DirectTarget<'_>) {
+        if let DirectTarget::Field(slot) = target
+            && let Some(tag) = slot.tag
+        {
+            self.set_bit(tag, true);
+        }
+    }
+
+    /// Leave a nullable field in its zero-initialized null representation.
+    pub fn write_null(&mut self, target: DirectTarget<'_>) {
+        let DirectTarget::Field(slot) = target else {
+            panic!("top-level Mojom values cannot be nullable")
+        };
+        if let Some(tag) = slot.tag {
+            self.set_bit(tag, false);
+        }
+    }
+
+    /// Write a primitive/enum/handle into a previously reserved field slot.
+    pub fn write_leaf(&mut self, target: DirectTarget<'_>, value: MojomValue) {
+        let DirectTarget::Field(slot) = target else {
+            panic!("leaf values cannot be top-level Mojom payloads")
+        };
+        match slot.value.expect("leaf field must have a value slot") {
+            ValueSlot::Bit(bit) => {
+                let MojomValue::Bool(value) = value else {
+                    panic!("only booleans may use Mojom bit slots")
+                };
+                self.set_bit(bit, value);
+            }
+            ValueSlot::Inline { location, wire_type } => {
+                let MojomWireType::Leaf { leaf_type, .. } = wire_type.resolve_recursive() else {
+                    panic!("direct leaf serialization requires a leaf wire type")
+                };
+                let bytes: SmallVec<[u8; 8]> = match (value, leaf_type) {
+                    (MojomValue::Bool(v), PackedLeafType::Bool) => {
+                        u8::from(v).to_le_bytes().into_iter().collect()
+                    }
+                    (MojomValue::Int8(v), PackedLeafType::Int8) => {
+                        v.to_le_bytes().into_iter().collect()
+                    }
+                    (MojomValue::UInt8(v), PackedLeafType::UInt8) => {
+                        v.to_le_bytes().into_iter().collect()
+                    }
+                    (MojomValue::Int16(v), PackedLeafType::Int16) => {
+                        v.to_le_bytes().into_iter().collect()
+                    }
+                    (MojomValue::UInt16(v), PackedLeafType::UInt16) => {
+                        v.to_le_bytes().into_iter().collect()
+                    }
+                    (MojomValue::Int32(v), PackedLeafType::Int32) => {
+                        v.to_le_bytes().into_iter().collect()
+                    }
+                    (MojomValue::UInt32(v), PackedLeafType::UInt32) => {
+                        v.to_le_bytes().into_iter().collect()
+                    }
+                    (MojomValue::Int64(v), PackedLeafType::Int64) => {
+                        v.to_le_bytes().into_iter().collect()
+                    }
+                    (MojomValue::UInt64(v), PackedLeafType::UInt64) => {
+                        v.to_le_bytes().into_iter().collect()
+                    }
+                    (MojomValue::Float32(v), PackedLeafType::Float32) => {
+                        v.to_le_bytes().into_iter().collect()
+                    }
+                    (MojomValue::Float64(v), PackedLeafType::Float64) => {
+                        v.to_le_bytes().into_iter().collect()
+                    }
+                    (MojomValue::Enum(v), PackedLeafType::Enum { .. }) => {
+                        v.to_le_bytes().into_iter().collect()
+                    }
+                    (MojomValue::Handle(handle), PackedLeafType::Handle) => {
+                        let index = self.handles.len() as u32;
+                        self.handles.push(handle);
+                        index.to_le_bytes().into_iter().collect()
+                    }
+                    _ => panic!("direct serializer got a primitive value/wire-type mismatch"),
+                };
+                self.bytes[location..location + bytes.len()].copy_from_slice(&bytes);
+            }
+        }
+    }
+
+    /// Reserve an inline or pointer-backed union and return the slot for its
+    /// selected variant payload.
+    pub fn begin_union<'a>(&mut self, target: DirectTarget<'a>, tag: i32) -> DirectSlot<'a> {
+        let (start, variants) = match target {
+            DirectTarget::Root(_) => panic!("Mojom unions cannot be top-level payloads"),
+            DirectTarget::Field(slot) => match slot.value.expect("union must have a value slot") {
+                ValueSlot::Bit(_) => panic!("union cannot be represented as a bit"),
+                ValueSlot::Inline { location, wire_type } => match wire_type.resolve_recursive() {
+                    MojomWireType::Union { variants, .. } => (location, variants),
+                    MojomWireType::Pointer {
+                        nested_data_type: PackedStructuredType::Union { variants },
+                        ..
+                    } => {
+                        let start = self.nested_start(location);
+                        self.bytes.resize(start + 16, 0);
+                        (start, variants)
+                    }
+                    _ => panic!("direct union serialization requires a union wire type"),
+                },
+            },
+        };
+        // Inline union storage was reserved by its enclosing structured body.
+        if self.bytes.len() < start + 16 {
+            self.bytes.resize(start + 16, 0);
+        }
+        self.write_u32(start, 16);
+        self.write_u32(start + 4, tag as u32);
+        let wire_type =
+            variants.get(&tag).expect("union discriminant must exist").resolve_recursive();
+        DirectSlot { value: Some(ValueSlot::Inline { location: start + 8, wire_type }), tag: None }
+    }
+
+    /// Serialize a map as the Mojom wire-format pair of key/value arrays.
+    pub fn begin_map<'a>(
+        &mut self,
+        target: DirectTarget<'a>,
+        num_elements: usize,
+    ) -> (DirectSlots<'a>, DirectMapValues<'a>) {
+        let (pointer_location, wire_type) = Self::inline_value(target);
+        let MojomWireType::Pointer {
+            nested_data_type: PackedStructuredType::Map { key_type, value_type },
+            ..
+        } = wire_type
+        else {
+            panic!("direct map serialization requires a map pointer")
+        };
+
+        self.nested_start(pointer_location);
+        let map_start = self.bytes.len();
+        // Header + two 8-byte array pointers.
+        self.bytes.resize(map_start + 24, 0);
+        self.write_u32(map_start, 24);
+        let keys = self.begin_array_with_type(map_start + 8, key_type, num_elements);
+        let values = DirectMapValues { pointer_location: map_start + 16, value_type, num_elements };
+        (keys, values)
+    }
+
+    /// Begin a map's value array after the key array has been completely
+    /// serialized, including any nested key data.
+    pub fn begin_map_values<'a>(&mut self, values: DirectMapValues<'a>) -> DirectSlots<'a> {
+        self.begin_array_with_type(values.pointer_location, values.value_type, values.num_elements)
+    }
+}
diff --git a/services/data_decoder/xml/xml_parser_mojo.rs b/services/data_decoder/xml/xml_parser_mojo.rs
new file mode 100644
index 0000000000000000000000000000000000000000..743a2ec1ec592eb8590d0c3b38c2054bd130c79c
--- /dev/null
+++ b/services/data_decoder/xml/xml_parser_mojo.rs
@@ -0,0 +1,260 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! Rust-native production implementation of data_decoder.mojom.XmlParser.
+
+chromium::import! {
+    "//mojo/public/mojom/base:base_rust";
+    "//mojo/public/rust/bindings";
+    "//mojo/public/rust/system";
+    "//services/data_decoder/public/mojom:mojom_xml_parser_rust";
+}
+
+use base_rust::values::{DictionaryValue, ListValue, Value};
+use bindings::receiver::PendingReceiver;
+use mojom_xml_parser_rust::xml_parser::{
+    XmlParser as XmlParserMojom, XmlParser_WhitespaceBehavior as WhitespaceBehavior,
+};
+use quick_xml::errors::{Error as XmlError, IllFormedError};
+use quick_xml::events::{BytesRef, BytesStart, Event};
+use quick_xml::reader::Reader;
+use quick_xml::XmlVersion;
+use std::borrow::Cow;
+use std::collections::HashMap;
+use system::{message_pipe::MessageEndpoint, mojo_types::UntypedHandle};
+
+const MAX_DEPTH: usize = 200;
+type Dict = HashMap<String, Value>;
+
+struct ElementFrame {
+    tag: String,
+    attributes: Dict,
+    namespaces: Dict,
+    children: Vec<Value>,
+    text: Option<String>,
+}
+
+impl ElementFrame {
+    fn flush_text(&mut self, preserve: bool) {
+        let Some(text) = self.text.take() else {
+            return;
+        };
+        if preserve || !text.trim().is_empty() {
+            self.children.push(text_node("text", text));
+        }
+    }
+
+    fn into_value(self) -> Value {
+        let Self { tag, attributes, namespaces, children, .. } = self;
+        let mut node = Dict::with_capacity(
+            2 + usize::from(!attributes.is_empty())
+                + usize::from(!namespaces.is_empty())
+                + usize::from(!children.is_empty()),
+        );
+        node.insert("type".into(), string("element"));
+        node.insert("tag".into(), string(tag));
+        if !attributes.is_empty() {
+            node.insert("attributes".into(), dictionary(attributes));
+        }
+        if !namespaces.is_empty() {
+            node.insert("namespaces".into(), dictionary(namespaces));
+        }
+        if !children.is_empty() {
+            node.insert("children".into(), Value::list_value(ListValue { storage: children }));
+        }
+        dictionary(node)
+    }
+}
+
+#[cxx::bridge(namespace = "data_decoder")]
+mod ffi {
+    extern "Rust" {
+        fn BindXmlParser(raw_handle: usize);
+    }
+}
+
+struct XmlParser;
+
+fn string(value: impl Into<String>) -> Value {
+    Value::string_value(value.into())
+}
+
+fn dictionary(storage: Dict) -> Value {
+    Value::dictionary_value(DictionaryValue { storage })
+}
+
+fn text_node(kind: &str, text: String) -> Value {
+    let mut node = Dict::with_capacity(2);
+    node.insert("type".into(), string(kind));
+    node.insert("text".into(), string(text));
+    dictionary(node)
+}
+
+fn invalid_xml(message: impl std::fmt::Display) -> String {
+    format!("Invalid XML: failed to load: {message}")
+}
+
+fn start_frame(event: &BytesStart<'_>, root: bool) -> Result<ElementFrame, String> {
+    let (attributes, namespaces) = event.attributes().try_fold(
+        (Dict::new(), Dict::new()),
+        |(mut attributes, mut namespaces), attribute| {
+            let attribute = attribute.map_err(invalid_xml)?;
+            let key = attribute.key.as_ref();
+            let prefix = (key == "xmlns").then_some("").or_else(|| key.strip_prefix("xmlns:"));
+            let raw_value = attribute.value.as_ref();
+            let value = if raw_value
+                .as_bytes()
+                .iter()
+                .any(|byte| matches!(*byte, b'&' | b'\t' | b'\r' | b'\n'))
+            {
+                attribute
+                    .normalized_value(XmlVersion::Implicit1_0)
+                    .map_err(invalid_xml)?
+                    .into_owned()
+            } else {
+                // The XML input is already UTF-8 and, without entities or XML
+                // whitespace characters, normalization is byte-for-byte identity.
+                raw_value.to_owned()
+            };
+            match prefix {
+                Some(prefix) => {
+                    (prefix != "xml"
+                        && prefix != "xmlns"
+                        && (!root || !prefix.is_empty() || !value.is_empty()))
+                    .then(|| namespaces.insert(prefix.into(), string(value)));
+                }
+                None => {
+                    attributes.insert(key.into(), string(value));
+                }
+            }
+            Ok::<_, String>((attributes, namespaces))
+        },
+    )?;
+    Ok(ElementFrame {
+        tag: event.name().as_ref().into(),
+        attributes,
+        namespaces,
+        children: Vec::new(),
+        text: None,
+    })
+}
+
+fn entity_text(reference: &BytesRef<'_>) -> Result<String, String> {
+    reference
+        .resolve_char_ref()
+        .map_err(invalid_xml)?
+        .map(|value| value.to_string())
+        .or_else(|| quick_xml::escape::resolve_xml_entity(reference.as_ref()).map(str::to_owned))
+        .ok_or_else(|| invalid_xml(format_args!("Entity '{}' not defined", reference.as_ref())))
+}
+
+fn parse_error(error: XmlError, xml: &str, position: usize) -> String {
+    let message = match error {
+        XmlError::IllFormed(IllFormedError::MismatchedEndTag { expected, found }) => format!(
+            "Opening and ending tag mismatch: {expected} line {} and {found}",
+            xml[..position].bytes().filter(|byte| *byte == b'\n').count() + 1
+        ),
+        error => error.to_string(),
+    };
+    invalid_xml(message)
+}
+
+fn parse(xml: &str, preserve: bool) -> Result<Value, String> {
+    let mut parser = Reader::from_str(xml);
+    parser.config_mut().check_comments = true;
+    parser.config_mut().expand_empty_elements = true;
+    let mut stack: Vec<ElementFrame> = Vec::new();
+    let mut root = None;
+    loop {
+        match parser.read_event() {
+            Ok(Event::Start(event)) => {
+                (root.is_none() && stack.len() < MAX_DEPTH)
+                    .then_some(())
+                    .ok_or_else(|| invalid_xml("Invalid XML"))?;
+                stack.last_mut().map(|parent| parent.flush_text(preserve));
+                stack.push(start_frame(&event, stack.is_empty())?);
+            }
+            Ok(Event::End(_)) => {
+                stack.last_mut().ok_or_else(|| invalid_xml("Invalid XML"))?.flush_text(preserve);
+                let child = stack.pop().ok_or_else(|| invalid_xml("Invalid XML"))?.into_value();
+                if let Some(parent) = stack.last_mut() {
+                    parent.children.push(child);
+                } else {
+                    root = Some(child);
+                }
+            }
+            Ok(Event::Text(event)) => {
+                let raw = event.as_ref();
+                let data = if raw.as_bytes().contains(&b'\r') {
+                    event.xml10_content()
+                } else {
+                    Cow::Borrowed(raw)
+                };
+                (stack.is_empty() && (preserve || !data.trim().is_empty()))
+                    .then(|| Err(invalid_xml("Start tag expected")))
+                    .unwrap_or(Ok(()))?;
+                if let Some(parent) = stack.last_mut() {
+                    parent.text.get_or_insert_with(String::new).push_str(data.as_ref());
+                }
+            }
+            Ok(Event::GeneralRef(reference)) => {
+                let text = entity_text(&reference)?;
+                stack
+                    .last_mut()
+                    .ok_or_else(|| invalid_xml("Start tag expected"))?
+                    .text
+                    .get_or_insert_with(String::new)
+                    .push_str(&text);
+            }
+            Ok(Event::CData(event)) => {
+                let parent = stack.last_mut().ok_or_else(|| invalid_xml("Invalid XML"))?;
+                parent.flush_text(preserve);
+                let raw = event.as_ref();
+                let data = if raw.as_bytes().contains(&b'\r') {
+                    event.xml10_content().into_owned()
+                } else {
+                    raw.to_owned()
+                };
+                parent.children.push(text_node("cdata", data));
+            }
+            Ok(Event::Eof) => {
+                stack
+                    .is_empty()
+                    .then_some(())
+                    .ok_or_else(|| invalid_xml("Premature end of data in tag"))?;
+                break;
+            }
+            Err(error) => return Err(parse_error(error, xml, parser.error_position() as usize)),
+            _ => {
+                stack.last_mut().map(|parent| parent.flush_text(preserve));
+            }
+        };
+    }
+    root.ok_or_else(|| {
+        invalid_xml(if xml.is_empty() { "Document is empty" } else { "Start tag expected" })
+    })
+}
+
+impl XmlParserMojom for XmlParser {
+    fn Parse(
+        &mut self,
+        xml: String,
+        whitespace_behavior: WhitespaceBehavior,
+        response_callback: impl Send + 'static + FnOnce(Option<Value>, Option<String>),
+    ) {
+        let result = parse(&xml, whitespace_behavior == WhitespaceBehavior::kPreserveSignificant);
+        let (value, error) =
+            result.map_or_else(|error| (None, Some(error)), |value| (Some(value), None));
+        response_callback(value, error);
+    }
+}
+
+bindings::register_mojom_state_object_impls!(impl XmlParserMojom for XmlParser);
+
+#[allow(non_snake_case)]
+fn BindXmlParser(raw_handle: usize) {
+    // SAFETY: C++ transfers unique ownership of this live receiver handle.
+    let endpoint: MessageEndpoint = unsafe { UntypedHandle::wrap_raw_value(raw_handle) }.into();
+    let _ = PendingReceiver::<dyn XmlParserMojom>::new(endpoint).bind_self_owned(XmlParser);
+}
