new file mode 100644
index 0000000000000000000000000000000000000000..d9448adb3866f9a795bd10f83836871582bfd429
--- /dev/null
+++ b/services/data_decoder/xml_parser_perftest.cc
@@ -0,0 +1,127 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <algorithm>
+#include <cstdint>
+#include <iostream>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/process/process_metrics.h"
+#include "base/run_loop.h"
+#include "base/task/single_thread_task_executor.h"
+#include "base/time/time.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/data_decoder/public/mojom/xml_parser.mojom.h"
+#include "services/data_decoder/xml_migration_test_support.h"
+
+namespace data_decoder {
+namespace {
+
+constexpr int kWarmupMessages = 100;
+constexpr int kMessagesPerSample = 1000;
+
+std::string XmlForCase(std::string_view name) {
+  if (name == "small_xml") {
+    return "<root><item>value</item></root>";
+  }
+  if (name == "attributes_namespaces") {
+    return "<root xmlns='urn:default' xmlns:a='urn:a' id='root' enabled='true'>"
+           "<a:item id='7' kind='sample' a:flag='yes'>value</a:item>"
+           "</root>";
+  }
+  if (name == "mixed_text_cdata") {
+    return "<root>prefix<![CDATA[<literal>&data</literal>]]>middle"
+           "<child>nested text</child>suffix</root>";
+  }
+  if (name == "large_xml") {
+    std::string xml = "<root xmlns:a='urn:a'>";
+    for (int i = 0; i < 256; ++i) {
+      xml += "<a:item id='" + std::to_string(i) +
+             "' enabled='true'>payload-text<![CDATA[cdata-payload]]></a:item>";
+    }
+    xml += "</root>";
+    return xml;
+  }
+  return {};
+}
+
+bool ParseOnce(mojo::Remote<mojom::XmlParser>& parser, const std::string& xml) {
+  base::RunLoop run_loop;
+  bool success = false;
+  parser->Parse(xml, mojom::XmlParser::WhitespaceBehavior::kIgnore,
+                base::BindOnce(
+                    [](base::RunLoop* run_loop, bool* success,
+                       std::optional<base::Value> value,
+                       const std::optional<std::string>& error) {
+                      *success = value.has_value() && !error.has_value();
+                      run_loop->Quit();
+                    },
+                    &run_loop, &success));
+  run_loop.Run();
+  return success;
+}
+
+int Run(std::string_view case_name) {
+  const std::string xml = XmlForCase(case_name);
+  if (xml.empty()) {
+    std::cerr << "unknown case: " << case_name << '\n';
+    return 2;
+  }
+
+  base::SingleThreadTaskExecutor task_executor;
+  test::EnsureMojoInitializedForXmlMigrationTests();
+  mojo::Remote<mojom::XmlParser> parser;
+  auto receiver = parser.BindNewPipeAndPassReceiver();
+  BindXmlParser(receiver.PassPipe().release().value());
+
+  for (int i = 0; i < kWarmupMessages; ++i) {
+    if (!ParseOnce(parser, xml)) {
+      return 3;
+    }
+  }
+
+  std::vector<int64_t> latencies_ns;
+  latencies_ns.reserve(kMessagesPerSample);
+  for (int i = 0; i < kMessagesPerSample; ++i) {
+    const base::TimeTicks start = base::TimeTicks::Now();
+    if (!ParseOnce(parser, xml)) {
+      return 4;
+    }
+    latencies_ns.push_back((base::TimeTicks::Now() - start).InNanoseconds());
+  }
+
+  const auto memory_info =
+      base::ProcessMetrics::CreateCurrentProcessMetrics()->GetMemoryInfo();
+  if (!memory_info.has_value()) {
+    return 5;
+  }
+
+  std::cout << "{\"case\":\"" << case_name
+            << "\",\"warmup_messages\":" << kWarmupMessages
+            << ",\"messages\":" << kMessagesPerSample
+            << ",\"rss_bytes\":" << memory_info->resident_set_bytes
+            << ",\"latencies_ns\":[";
+  for (size_t i = 0; i < latencies_ns.size(); ++i) {
+    if (i != 0) {
+      std::cout << ',';
+    }
+    std::cout << latencies_ns[i];
+  }
+  std::cout << "]}\n";
+  return 0;
+}
+
+}  // namespace
+}  // namespace data_decoder
+
+int main(int argc, char** argv) {
+  base::CommandLine::Init(argc, argv);
+  return data_decoder::Run(
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("case"));
+}
