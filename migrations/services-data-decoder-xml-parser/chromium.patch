+        let name = QName("foo:");
+        assert_eq!(name.prefix(), Some(Prefix("foo")));
+        assert_eq!(name.local_name(), LocalName(""));
+        assert_eq!(name.decompose(), (LocalName(""), Some(Prefix("foo"))));
