diff --git a/services/metrics/rust/ukm_recorder_interface.rs b/services/metrics/rust/ukm_recorder_interface.rs
new file mode 100644
index 0000000000..39ec82a56f
--- /dev/null
+++ b/services/metrics/rust/ukm_recorder_interface.rs
@@ -0,0 +1,110 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! Rust implementation of the UKM recorder factory and recorder Mojo receivers.
+
+chromium::import! {
+    "//mojo/public/rust/bindings";
+    "//mojo/public/rust/system";
+    "//services/metrics/public/mojom:mojom_rust";
+}
+
+use mojom_rust::ukm_interface::{
+    UkmEntry, UkmRecorderClientInterface, UkmRecorderFactory, UkmRecorderInterface,
+};
+use system::scoped_handle_interop;
+
+#[cxx::bridge(namespace = "metrics")]
+mod ffi {
+    unsafe extern "C++" {
+        include!("services/metrics/ukm_recorder_factory_impl.h");
+        include!("mojo/public/rust/system/scoped_handle_interop.h");
+
+        type UkmRecorderFactoryImpl;
+
+        #[namespace = "mojo::rust"]
+        type ScopedMessagePipeHandleWrapper =
+            system::scoped_handle_interop::ScopedMessagePipeHandleWrapper;
+
+        fn AddEntry(
+            self: &UkmRecorderFactoryImpl,
+            source_id: i64,
+            event_hash: u64,
+            hashes: &[u64],
+            values: &[i64],
+        );
+        fn UpdateSourceURL(self: &UkmRecorderFactoryImpl, source_id: i64, url: &str);
+        fn AddUkmClientFromRust(handle: UniquePtr<ScopedMessagePipeHandleWrapper>);
+    }
+
+    extern "Rust" {
+        fn BindUkmRecorderFactory(
+            handle: UniquePtr<ScopedMessagePipeHandleWrapper>,
+            bridge: SharedPtr<UkmRecorderFactoryImpl>,
+        );
+    }
+}
+
+#[derive(Clone)]
+struct RecorderInterface(cxx::SharedPtr<ffi::UkmRecorderFactoryImpl>);
+
+// SAFETY: Mojo binds this state to the current default sequence. The C++
+// capability enforces that same sequence for every UkmRecorder access.
+unsafe impl Send for RecorderInterface {}
+
+#[derive(Clone)]
+struct RecorderFactory(cxx::SharedPtr<ffi::UkmRecorderFactoryImpl>);
+
+// SAFETY: the factory receiver and every child receiver bind on the same
+// current default sequence; the shared C++ capability checks that sequence.
+unsafe impl Send for RecorderFactory {}
+
+impl UkmRecorderInterface for RecorderInterface {
+    fn AddEntry(&mut self, entry: UkmEntry) {
+        let (hashes, values): (Vec<_>, Vec<_>) = entry.metrics.into_iter().unzip();
+        self.0.AddEntry(entry.source_id, entry.event_hash, &hashes, &values);
+    }
+
+    fn UpdateSourceURL(&mut self, source_id: i64, url: String) {
+        self.0.UpdateSourceURL(source_id, &url);
+    }
+}
+
+impl UkmRecorderFactory for RecorderFactory {
+    fn CreateUkmRecorder(
+        &mut self,
+        receiver: bindings::receiver::PendingReceiver<dyn UkmRecorderInterface>,
+        client_remote: Option<bindings::remote::PendingRemote<dyn UkmRecorderClientInterface>>,
+    ) {
+        let _ = receiver.bind_self_owned(RecorderInterface(self.0.clone()));
+
+        if let Some(client_remote) = client_remote {
+            ffi::AddUkmClientFromRust(
+                scoped_handle_interop::ScopedMessagePipeHandleWrapper::from_message_endpoint(
+                    client_remote.into_endpoint(),
+                ),
+            );
+        }
+    }
+}
+
+bindings::register_mojom_state_object_impls!(impl UkmRecorderInterface for RecorderInterface);
+bindings::register_mojom_state_object_impls!(impl UkmRecorderFactory for RecorderFactory);
+
+#[allow(non_snake_case)]
+fn BindUkmRecorderFactory(
+    handle: cxx::UniquePtr<ffi::ScopedMessagePipeHandleWrapper>,
+    bridge: cxx::SharedPtr<ffi::UkmRecorderFactoryImpl>,
+) {
+    use bindings::receiver::PendingReceiver;
+
+    let endpoint =
+        scoped_handle_interop::ScopedMessagePipeHandleWrapper::into_message_endpoint(handle)
+            .expect("C++ must pass a valid UkmRecorderFactory message pipe");
+    let _ = PendingReceiver::<dyn UkmRecorderFactory>::new(endpoint)
+        .bind_self_owned(RecorderFactory(bridge));
+}
+
+#[cfg(test)]
+mod ukm_recorder_interface_unittest;
