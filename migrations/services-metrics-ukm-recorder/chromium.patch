+// Copyright 2023 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <memory>
+#include <utility>
+
+#include "base/memory/raw_ptr.h"
+#include "mojo/public/cpp/bindings/self_owned_receiver.h"
+#include "services/metrics/public/cpp/ukm_recorder_client_interface_registry.h"
+#include "services/metrics/ukm_recorder_factory_impl.h"
+#include "services/metrics/ukm_recorder_interface.h"
+
+namespace metrics {
+namespace {
+
+class LegacyUkmRecorderFactory final : public ukm::mojom::UkmRecorderFactory {
+ public:
+  explicit LegacyUkmRecorderFactory(ukm::UkmRecorder* recorder)
+      : recorder_(recorder) {}
+
+  LegacyUkmRecorderFactory(const LegacyUkmRecorderFactory&) = delete;
+  LegacyUkmRecorderFactory& operator=(const LegacyUkmRecorderFactory&) = delete;
+  ~LegacyUkmRecorderFactory() override = default;
+
+ private:
+  void CreateUkmRecorder(
+      mojo::PendingReceiver<ukm::mojom::UkmRecorderInterface> receiver,
+      mojo::PendingRemote<ukm::mojom::UkmRecorderClientInterface> client_remote)
+      override {
+    UkmRecorderInterface::Create(recorder_, std::move(receiver));
+    if (client_remote.is_valid()) {
+      UkmRecorderClientInterfaceRegistry::AddClientToCurrentRegistry(
+          std::move(client_remote));
+    }
+  }
+
+  raw_ptr<ukm::UkmRecorder> recorder_;
+};
+
+}  // namespace
+
+void UkmRecorderFactoryImpl::Create(
+    ukm::UkmRecorder* recorder,
+    mojo::PendingReceiver<ukm::mojom::UkmRecorderFactory> receiver) {
+  mojo::MakeSelfOwnedReceiver(
+      std::make_unique<LegacyUkmRecorderFactory>(recorder),
+      std::move(receiver));
+}
+
+}  // namespace metrics
