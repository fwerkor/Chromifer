+++ b/services/metrics/ukm_recorder_rust_bridge.h
@@ -0,0 +1,44 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef SERVICES_METRICS_UKM_RECORDER_RUST_BRIDGE_H_
+#define SERVICES_METRICS_UKM_RECORDER_RUST_BRIDGE_H_
+
+#include <cstdint>
+
+#include "base/memory/raw_ptr.h"
+#include "base/sequence_checker.h"
+#include "third_party/rust/cxx/v1/cxx.h"
+
+namespace ukm {
+class UkmRecorder;
+}
+
+namespace metrics {
+
+// Narrow C++ capability retained by the Rust UkmRecorderInterface. The
+// wrapper is owned by Rust, while the underlying UkmRecorder lifetime follows
+// the same browser-owned contract as the legacy implementation.
+class UkmRecorderBridge {
+ public:
+  explicit UkmRecorderBridge(ukm::UkmRecorder* recorder);
+  ~UkmRecorderBridge();
+
+  UkmRecorderBridge(const UkmRecorderBridge&) = delete;
+  UkmRecorderBridge& operator=(const UkmRecorderBridge&) = delete;
+
+  void AddEntry(int64_t source_id,
+                uint64_t event_hash,
+                rust::Slice<const uint64_t> metric_hashes,
+                rust::Slice<const int64_t> metric_values);
+  void UpdateSourceURL(int64_t source_id, rust::Str url);
+
+ private:
+  raw_ptr<ukm::UkmRecorder> recorder_;
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+}  // namespace metrics
+
+#endif  // SERVICES_METRICS_UKM_RECORDER_RUST_BRIDGE_H_
