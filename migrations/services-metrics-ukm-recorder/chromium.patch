+namespace metrics {
+namespace {
+
+constexpr uint64_t kDrainBatchSize = 1024;
+constexpr char kPerformanceUrl[] = "https://performance.test/path";
+
+class CountingUkmRecorder final : public ukm::UkmRecorder {
+ public:
+  void AddEntry(ukm::mojom::UkmEntryPtr entry) override {
+    ++entry_count_;
+    last_source_id_ = entry->source_id;
+  }
+
+  void RecordWebDXFeatures(ukm::SourceId,
+                           const std::set<int32_t>&,
+                           size_t) override {}
+
+  uint64_t call_count() const { return entry_count_ + url_count_; }
+  ukm::SourceId last_source_id() const { return last_source_id_; }
+
+ private:
+  void UpdateSourceURL(ukm::SourceId source_id, const GURL& url) override {
+    ++url_count_;
+    last_source_id_ = source_id;
+  }
+
+  void UpdateAppURL(ukm::SourceId, const GURL&, ukm::AppType) override {}
+  void RecordNavigation(ukm::SourceId,
+                        const ukm::UkmSource::NavigationData&) override {}
+  void MarkSourceForDeletion(ukm::SourceId) override {}
+
+  uint64_t entry_count_ = 0;
+  uint64_t url_count_ = 0;
+  ukm::SourceId last_source_id_ = 0;
+};
+
+uint64_t ParsePositiveSwitch(const base::CommandLine& command_line,
+                             std::string_view name) {
+  uint64_t value = 0;
+  if (!base::StringToUint64(command_line.GetSwitchValueASCII(name), &value) ||
+      value == 0) {
+    std::cerr << "invalid --" << name << " value\n";
+    std::exit(2);
+  }
+  return value;
+}
+
+uint64_t ResidentSetBytes() {
+  auto metrics = base::ProcessMetrics::CreateCurrentProcessMetrics();
+  auto memory_info = metrics->GetMemoryInfo();
+  if (!memory_info.has_value()) {
+    std::cerr << "failed to read current-process memory info\n";
+    std::exit(3);
+  }
+  return memory_info->resident_set_bytes;
+}
+
+void SendEntry(mojo::Remote<ukm::mojom::UkmRecorderInterface>& remote,
+               uint64_t sequence,
+               size_t metric_count) {
+  auto entry = ukm::mojom::UkmEntry::New();
+  entry->source_id = static_cast<ukm::SourceId>(sequence + 1);
+  entry->event_hash = 0x4348524f4d494645ULL;
+  for (size_t i = 0; i < metric_count; ++i) {
+    entry->metrics.emplace(1000 + i, static_cast<int64_t>(sequence + i));
+  }
+  remote->AddEntry(std::move(entry));
+}
+
+void SendMessages(std::string_view workload,
+                  uint64_t messages,
+                  mojo::Remote<ukm::mojom::UkmRecorderInterface>& remote,
+                  base::test::TaskEnvironment& task_environment) {
+  for (uint64_t i = 0; i < messages; ++i) {
+    if (workload == "add_entry_single_metric") {
+      SendEntry(remote, i, 1);
+    } else if (workload == "add_entry_eight_metrics") {
+      SendEntry(remote, i, 8);
+    } else if (workload == "update_source_url") {
+      remote->UpdateSourceURL(static_cast<ukm::SourceId>(i + 1),
+                              kPerformanceUrl);
+    } else if (workload == "mixed_90_add_entry_10_update_url") {
+      if (i % 10 == 9) {
+        remote->UpdateSourceURL(static_cast<ukm::SourceId>(i + 1),
+                                kPerformanceUrl);
+      } else {
+        SendEntry(remote, i, 1);
+      }
+    } else {
+      std::cerr << "unknown --case value: " << workload << "\n";
+      std::exit(2);
+    }
+
+    if ((i + 1) % kDrainBatchSize == 0) {
+      task_environment.RunUntilIdle();
+    }
+  }
+  task_environment.RunUntilIdle();
+}
+
+}  // namespace
+}  // namespace metrics
+
+int main(int argc, char** argv) {
+  base::CommandLine::Init(argc, argv);
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  const std::string workload = command_line.GetSwitchValueASCII("case");
+  const uint64_t warmup = metrics::ParsePositiveSwitch(command_line, "warmup");
+  const uint64_t messages =
+      metrics::ParsePositiveSwitch(command_line, "messages");
+
+  TestTimeouts::Initialize();
+  mojo::core::Init();
+  base::test::TaskEnvironment task_environment;
+  metrics::CountingUkmRecorder recorder;
+  mojo::Remote<ukm::mojom::UkmRecorderFactory> factory;
+  metrics::UkmRecorderFactoryImpl::Create(&recorder,
+                                          factory.BindNewPipeAndPassReceiver());
+  mojo::Remote<ukm::mojom::UkmRecorderInterface> remote;
+  factory->CreateUkmRecorder(remote.BindNewPipeAndPassReceiver(), {});
+  task_environment.RunUntilIdle();
+
+  metrics::SendMessages(workload, warmup, remote, task_environment);
+  const uint64_t rss_after_warmup = metrics::ResidentSetBytes();
+  const uint64_t calls_before_sample = recorder.call_count();
+
+  const base::TimeTicks start = base::TimeTicks::Now();
+  metrics::SendMessages(workload, messages, remote, task_environment);
+  const base::TimeDelta elapsed = base::TimeTicks::Now() - start;
+  const uint64_t rss_after_sample = metrics::ResidentSetBytes();
+  const uint64_t forwarded = recorder.call_count() - calls_before_sample;
+  if (forwarded != messages) {
+    std::cerr << "forwarding mismatch: expected=" << messages
+              << " actual=" << forwarded << "\n";
+    return 4;
+  }
+
+  const double ns_per_message = static_cast<double>(elapsed.InNanoseconds()) /
+                                static_cast<double>(messages);
+  std::cout << "case=" << workload << " ns_per_message=" << ns_per_message
+            << " rss_after_warmup=" << rss_after_warmup
+            << " rss_after_sample=" << rss_after_sample
+            << " forwarded_messages=" << forwarded
+            << " last_source_id=" << recorder.last_source_id() << '\n';
+  return 0;
+}
