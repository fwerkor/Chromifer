diff --git a/services/metrics/rust/ukm_recorder_interface.rs b/services/metrics/rust/ukm_recorder_interface.rs
new file mode 100644
index 0000000000..f3df149dce
--- /dev/null
+++ b/services/metrics/rust/ukm_recorder_interface.rs
@@ -0,0 +1,102 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! Rust implementation of `ukm.mojom.UkmRecorderInterface`.
+
+chromium::import! {
+    "//mojo/public/rust/bindings";
+    "//mojo/public/rust/system";
+    "//services/metrics/public/mojom:mojom_rust";
+}
+
+use mojom_rust::ukm_interface::{UkmEntry, UkmRecorderInterface};
+use system::scoped_handle_interop;
+
+#[cxx::bridge(namespace = "metrics")]
+mod ffi {
+    unsafe extern "C++" {
+        include!("services/metrics/ukm_recorder_rust_bridge.h");
+
+        type UkmRecorderBridge;
+
+        fn AddEntry(
+            self: Pin<&mut UkmRecorderBridge>,
+            source_id: i64,
+            event_hash: u64,
+            metric_hashes: &[u64],
+            metric_values: &[i64],
+        );
+        fn UpdateSourceURL(self: Pin<&mut UkmRecorderBridge>, source_id: i64, url: &str);
+
+        include!("mojo/public/rust/system/scoped_handle_interop.h");
+        #[namespace = "mojo::rust"]
+        type ScopedMessagePipeHandleWrapper =
+            system::scoped_handle_interop::ScopedMessagePipeHandleWrapper;
+    }
+
+    extern "Rust" {
+        fn BindUkmRecorderInterface(
+            handle: UniquePtr<ScopedMessagePipeHandleWrapper>,
+            recorder: UniquePtr<UkmRecorderBridge>,
+        );
+    }
+}
+
+struct SequenceBoundRecorder(cxx::UniquePtr<ffi::UkmRecorderBridge>);
+
+// SAFETY: `BindUkmRecorderInterface` constructs this value on the sequence
+// where the C++ factory is running and immediately moves it into a Mojo
+// receiver bound to that same current default sequence. This private wrapper
+// is never exposed or moved independently, and all recorder access happens
+// from callbacks dispatched by that receiver. The C++ bridge additionally
+// DCHECKs the sequence on every operation and destruction.
+unsafe impl Send for SequenceBoundRecorder {}
+
+struct UkmRecorderInterfaceImpl {
+    recorder: SequenceBoundRecorder,
+}
+
+impl UkmRecorderInterfaceImpl {
+    fn new(recorder: cxx::UniquePtr<ffi::UkmRecorderBridge>) -> Self {
+        assert!(!recorder.is_null());
+        Self { recorder: SequenceBoundRecorder(recorder) }
+    }
+}
+
+impl UkmRecorderInterface for UkmRecorderInterfaceImpl {
+    fn AddEntry(&mut self, entry: UkmEntry) {
+        let mut metric_hashes = Vec::with_capacity(entry.metrics.len());
+        let mut metric_values = Vec::with_capacity(entry.metrics.len());
+        for (hash, value) in entry.metrics {
+            metric_hashes.push(hash);
+            metric_values.push(value);
+        }
+        self.recorder.0.pin_mut().AddEntry(
+            entry.source_id,
+            entry.event_hash,
+            &metric_hashes,
+            &metric_values,
+        );
+    }
+
+    fn UpdateSourceURL(&mut self, source_id: i64, url: String) {
+        self.recorder.0.pin_mut().UpdateSourceURL(source_id, &url);
+    }
+}
+
+bindings::register_mojom_state_object_impls!(impl UkmRecorderInterface for UkmRecorderInterfaceImpl);
+
+#[allow(non_snake_case)]
+fn BindUkmRecorderInterface(
+    handle: cxx::UniquePtr<ffi::ScopedMessagePipeHandleWrapper>,
+    recorder: cxx::UniquePtr<ffi::UkmRecorderBridge>,
+) {
+    use bindings::receiver::PendingReceiver;
+
+    let endpoint =
+        scoped_handle_interop::ScopedMessagePipeHandleWrapper::into_message_endpoint(handle)
+            .expect("C++ must pass a valid UkmRecorderInterface message pipe");
+    let pending_receiver = PendingReceiver::<dyn UkmRecorderInterface>::new(endpoint);
+    let _ = pending_receiver.bind_self_owned(UkmRecorderInterfaceImpl::new(recorder));
+}
