@@ -0,0 +1,148 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "services/metrics/ukm_recorder_buildflags.h"
+
+#if BUILDFLAG(USE_RUST_UKM_RECORDER)
+#include "services/metrics/ukm_recorder_rust_bridge.h"
+#endif
+
+#include <array>
+#include <cstdint>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/test/task_environment.h"
+#include "mojo/core/embedder/embedder.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/metrics/public/cpp/ukm_recorder.h"
+#include "services/metrics/public/mojom/ukm_interface.mojom.h"
+#include "services/metrics/ukm_recorder_factory_impl.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace metrics {
+namespace {
+
+class FakeUkmRecorder final : public ukm::UkmRecorder {
+ public:
+  FakeUkmRecorder() = default;
+  ~FakeUkmRecorder() override = default;
+
+  void AddEntry(ukm::mojom::UkmEntryPtr entry) override {
+    entries_.push_back(std::move(entry));
+  }
+
+  void RecordWebDXFeatures(ukm::SourceId source_id,
+                           const std::set<int32_t>& features,
+                           size_t max_feature_value) override {}
+
+  const ukm::mojom::UkmEntry* last_entry() const {
+    return entries_.empty() ? nullptr : entries_.back().get();
+  }
+  const ukm::mojom::UkmEntry* entry_at(size_t index) const {
+    return entries_.at(index).get();
+  }
+  size_t entry_count() const { return entries_.size(); }
+  ukm::SourceId last_source_id() const { return last_source_id_; }
+  const GURL& last_source_url() const { return last_source_url_; }
+
+ private:
+  void UpdateSourceURL(ukm::SourceId source_id, const GURL& url) override {
+    last_source_id_ = source_id;
+    last_source_url_ = url;
+  }
+
+  void UpdateAppURL(ukm::SourceId source_id,
+                    const GURL& url,
+                    ukm::AppType app_type) override {}
+
+  void RecordNavigation(
+      ukm::SourceId source_id,
+      const ukm::UkmSource::NavigationData& navigation_data) override {}
+
+  void MarkSourceForDeletion(ukm::SourceId source_id) override {}
+
+  std::vector<ukm::mojom::UkmEntryPtr> entries_;
+  ukm::SourceId last_source_id_ = 0;
+  GURL last_source_url_;
+};
+
+#if BUILDFLAG(USE_RUST_UKM_RECORDER)
+TEST(UkmRecorderInterfaceTest, RustBridgeForwardsEntry) {
+  FakeUkmRecorder recorder;
+  UkmRecorderBridge bridge(&recorder);
+  constexpr std::array<uint64_t, 2> kMetricHashes = {11, 22};
+  constexpr std::array<int64_t, 2> kMetricValues = {-5, 7};
+
+  bridge.AddEntry(
+      123, 456,
+      rust::Slice<const uint64_t>(kMetricHashes.data(), kMetricHashes.size()),
+      rust::Slice<const int64_t>(kMetricValues.data(), kMetricValues.size()));
+
+  ASSERT_TRUE(recorder.last_entry());
+  EXPECT_EQ(recorder.last_entry()->source_id, 123);
+  EXPECT_EQ(recorder.last_entry()->event_hash, 456u);
+  ASSERT_EQ(recorder.last_entry()->metrics.size(), 2u);
+  EXPECT_EQ(recorder.last_entry()->metrics.at(11), -5);
+  EXPECT_EQ(recorder.last_entry()->metrics.at(22), 7);
+}
+
+TEST(UkmRecorderInterfaceTest, RustBridgeForwardsSourceUrl) {
+  FakeUkmRecorder recorder;
+  UkmRecorderBridge bridge(&recorder);
+  const std::string url = "https://example.test/path";
+
+  bridge.UpdateSourceURL(789, rust::Str(url));
+
+  EXPECT_EQ(recorder.last_source_id(), 789);
+  EXPECT_EQ(recorder.last_source_url(), GURL(url));
+}
+
+#endif  // BUILDFLAG(USE_RUST_UKM_RECORDER)
+
+TEST(UkmRecorderInterfaceTest, ReceiverForwardsMojoCalls) {
+  mojo::core::Init();
+  base::test::TaskEnvironment task_environment;
+  FakeUkmRecorder recorder;
+  mojo::Remote<ukm::mojom::UkmRecorderFactory> factory;
+  UkmRecorderFactoryImpl::Create(&recorder,
+                                 factory.BindNewPipeAndPassReceiver());
+
+  mojo::Remote<ukm::mojom::UkmRecorderInterface> remote;
+  factory->CreateUkmRecorder(remote.BindNewPipeAndPassReceiver(), {});
+
+  auto first_entry = ukm::mojom::UkmEntry::New();
+  first_entry->source_id = 321;
+  first_entry->event_hash = 654;
+  first_entry->metrics.emplace(33, -9);
+  first_entry->metrics.emplace(44, 17);
+  remote->AddEntry(std::move(first_entry));
+
+  auto second_entry = ukm::mojom::UkmEntry::New();
+  second_entry->source_id = 322;
+  second_entry->event_hash = 655;
+  second_entry->metrics.emplace(55, 0);
+  remote->AddEntry(std::move(second_entry));
+  remote->UpdateSourceURL(987, "https://receiver.test/path");
+  task_environment.RunUntilIdle();
+
+  ASSERT_EQ(recorder.entry_count(), 2u);
+  EXPECT_EQ(recorder.entry_at(0)->source_id, 321);
+  EXPECT_EQ(recorder.entry_at(0)->event_hash, 654u);
+  ASSERT_EQ(recorder.entry_at(0)->metrics.size(), 2u);
+  EXPECT_EQ(recorder.entry_at(0)->metrics.at(33), -9);
+  EXPECT_EQ(recorder.entry_at(0)->metrics.at(44), 17);
+  EXPECT_EQ(recorder.entry_at(1)->source_id, 322);
+  EXPECT_EQ(recorder.entry_at(1)->event_hash, 655u);
+  ASSERT_EQ(recorder.entry_at(1)->metrics.size(), 1u);
+  EXPECT_EQ(recorder.entry_at(1)->metrics.at(55), 0);
+  EXPECT_EQ(recorder.last_source_id(), 987);
+  EXPECT_EQ(recorder.last_source_url(), GURL("https://receiver.test/path"));
+}
+
+}  // namespace
+}  // namespace metrics
