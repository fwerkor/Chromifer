@@ -0,0 +1,46 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "services/metrics/ukm_recorder_rust_bridge.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/check.h"
+#include "services/metrics/public/cpp/ukm_recorder.h"
+#include "services/metrics/public/mojom/ukm_interface.mojom.h"
+#include "url/gurl.h"
+
+namespace metrics {
+
+UkmRecorderBridge::UkmRecorderBridge(ukm::UkmRecorder* recorder)
+    : recorder_(recorder) {
+  CHECK(recorder_);
+}
+
+UkmRecorderBridge::~UkmRecorderBridge() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+}
+
+void UkmRecorderBridge::AddEntry(int64_t source_id,
+                                 uint64_t event_hash,
+                                 rust::Slice<const uint64_t> metric_hashes,
+                                 rust::Slice<const int64_t> metric_values) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK_EQ(metric_hashes.size(), metric_values.size());
+  auto entry = ukm::mojom::UkmEntry::New();
+  entry->source_id = source_id;
+  entry->event_hash = event_hash;
+  for (size_t index = 0; index < metric_hashes.size(); ++index) {
+    entry->metrics.emplace(metric_hashes[index], metric_values[index]);
+  }
+  recorder_->AddEntry(std::move(entry));
+}
+
+void UkmRecorderBridge::UpdateSourceURL(int64_t source_id, rust::Str url) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  recorder_->UpdateSourceURL(source_id, GURL(std::string(url)));
+}
+
+}  // namespace metrics
diff --git a/services/metrics/ukm_recorder_rust_bridge.h b/services/metrics/ukm_recorder_rust_bridge.h
new file mode 100644
index 0000000000..2cae0552df
